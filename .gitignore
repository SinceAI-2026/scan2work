# secrets: never commit
secrets.env
.env
# local environment
.venv/
__pycache__/
*.pyc
.DS_Store
# generated by the pipeline (rebuild with: bash scripts/check.sh)
web/data/*
# ...except the inputs and the AI answer cache, which make a rebuild free and reproducible
!web/data/decisions_cache.json
!web/data/walk_poses.json
# ...and the Take apart / AI 3D assets (scripts/import_take_apart.py regenerates them), so no import step is needed
!web/data/take_apart/

# the voice assistant MCP token: never commit
.mcp_token
web/data/field_log.json.lock

# Local credentials and developer tooling (keep checked-in examples)
.env.*
!.env.example
board.env
*.pem
*.key
.gcp/
.wrangler/
node_modules/
# Local scanner reports may contain sensitive findings
*secret-scan*.json
*gitleaks*.json
