{
	admin off
	auto_https off
}

# Public HTTP origin ports. The external HTTPS edge terminates TLS.
# This is a separate Caddy process, not the instance's management/auth proxy.
http://:10100 {
	reverse_proxy 127.0.0.1:9080
}

http://:10200 {
	reverse_proxy 127.0.0.1:9081
}

# Voice assistant MCP server (mcp_server.py). Only the Worker's /mcp route should reach this port;
# requests through it must carry the FIELD_ATLAS_MCP_TOKEN bearer token.
http://:10300 {
	reverse_proxy 127.0.0.1:9082
}
