# Copy to live/.env (git-ignored). Everything here is optional.
# Shared secret the board sends with every request (header X-Live-Token). Set it when the server is public.
LIVE_TOKEN=
# Tiger Data (Postgres + TimescaleDB): the board's heartbeats
TIGER_DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
# Snowflake: the panel's event log (DEVICE_EVENTS). Key-pair login or a programmatic access token.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_TOKEN=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=VALMET_WH
SNOWFLAKE_DATABASE=VALMET_TWIN
SNOWFLAKE_SCHEMA=PLANT
