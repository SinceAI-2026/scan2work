# Copy to board.env (git-ignored) in this folder before deploying the app to the board.
# The Field Atlas server: a public HTTPS address, or http://<laptop IP>:8765 on the same network (server.py 8765 --lan)
PLANT_API=https://field-atlas.example.com
# The same value as LIVE_TOKEN in the server's live/.env (leave empty if the server sets none)
LIVE_TOKEN=
