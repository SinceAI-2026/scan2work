# Copy to board.env (git-ignored) in this folder before deploying the app to the board.
# The Scan2Work server: a public HTTPS address, or http://<laptop IP>:8765 on the same network (server.py 8765 --lan)
PLANT_API=https://scan2work.example.com
# Same value as the server's LIVE_TOKEN or LIVE_TOKEN_FILE. Required on the public site.
# Only an unprotected local development server may leave this empty.
LIVE_TOKEN=
